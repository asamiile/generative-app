# URL the browser uses to fetch images directly (public information -- static file serving is unauthenticated)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Where the Next.js server (BFF) reaches FastAPI. Under docker-compose this becomes http://backend:8000
BACKEND_API_URL=http://localhost:8000

# Set to the same value as APP_API_TOKEN in backend/.env (server-side only, never sent to the browser)
APP_API_TOKEN=
