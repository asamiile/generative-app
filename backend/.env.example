# Gemini API key issued from AI Studio
GEMINI_API_KEY=
# Aspect ratio for the 4K finalize step (a value accepted by gemini-3-pro-image's
# image_config.aspect_ratio). Previews stay square to match the source image (this
# setting doesn't apply to them).
GEMINI_ASPECT_RATIO=16:9

# Shared token used to authenticate the frontend (set a long random string)
APP_API_TOKEN=

# Rate limit for the image generation endpoints (requests per hour)
RATE_LIMIT_PER_HOUR=10

# SQLite connection string (overridden by docker-compose.yml when using docker-compose)
DATABASE_URL=sqlite:///./history.db

# Endpoint used by the local provider (leave as-is under docker-compose -- it resolves
# ollama/comfyui by service name over the internal network, not localhost)
OLLAMA_BASE_URL=http://ollama:11434
# Pull this ahead of time with `docker compose exec ollama ollama pull <model>`.
# Tags change fast, check https://ollama.com/library for the current lineup.
OLLAMA_TEXT_MODEL=llama3.1:8b

COMFYUI_BASE_URL=http://comfyui:8188
# A photorealistic SDXL-family checkpoint. Download it manually into the
# comfyui_models volume's models/checkpoints/ (several GB, not bundled in the image).
# CPU-only inference (no GPU passthrough) is very slow, so a turbo/lightning-distilled
# few-step checkpoint is strongly recommended over a standard 20-30 step model
# (COMFYUI_STEPS etc. below are already tuned for that kind of checkpoint).
COMFYUI_CHECKPOINT=juggernautXL_v10.safetensors
# Poll timeout for local generation (seconds). CPU-only inference runs much longer, adjust accordingly.
LOCAL_GENERATION_TIMEOUT_SECONDS=900

# Sampling parameters. Defaults assume an SDXL-Turbo/Lightning-family (few-step)
# checkpoint. For a standard checkpoint (e.g. Juggernaut XL), switch back to roughly
# steps=20-30, cfg=5-7, sampler=dpmpp_2m, scheduler=karras (much slower on CPU, though).
COMFYUI_STEPS=8
COMFYUI_CFG=1.5
COMFYUI_SAMPLER=euler
COMFYUI_SCHEDULER=sgm_uniform
# Square (the source image is square, so the preview display is too). Finalize
# separately targets 16:9, but resizing this preview image uses crop="center" so it
# never gets stretched (the ImageScale node in img2img_upscale.json).
COMFYUI_WIDTH=1024
COMFYUI_HEIGHT=1024
# img2img denoise strength for finalize (upscale). Lower preserves the source composition more.
COMFYUI_UPSCALE_DENOISE=0.35
# Final resolution for finalize (16:9). No AI upscale model is used -- the selected
# preview is resized to this size directly, then refined via img2img.
# Measured (2026-08-08, CPU inference / 24GB Docker, square-equivalent): ~7 min at an
# equivalent pixel count (~1024x1024), 1h14m at 4x that (~2048x2048); 3840x3840 ("true"
# 4K) would be 7-8+ hours and isn't practical. 1280x720 has roughly the same pixel
# count as the old 1024x1024 default.
COMFYUI_FINAL_WIDTH=1280
COMFYUI_FINAL_HEIGHT=720
# Tile size/overlap for splitting VAEEncode/VAEDecode into tiles. A single-pass
# (non-tiled) run OOM'd even at 2048x2048 on CPU, so tiling (VAEEncodeTiled/
# VAEDecodeTiled) keeps peak memory bounded. Same as ComfyUI's own node defaults.
COMFYUI_VAE_TILE_SIZE=512
COMFYUI_VAE_TILE_OVERLAP=64

# OpenAI (GPT Image) provider. Issue a key at https://platform.openai.com/api-keys
# Model names change fast, check https://platform.openai.com/docs/models
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# Preview is square (one of the official standard sizes). Only finalize targets 16:9
# (no official size is exactly 16:9, so this is a custom size that's a multiple of 16
# and exactly 16:9 -- if the API rejects it, fall back to the official 1536x1024, 3:2).
OPENAI_PREVIEW_SIZE=1024x1024
OPENAI_FINAL_SIZE=2048x1152

# Stability AI (Stable Image) provider. Issue a key at https://platform.stability.ai/account/keys
# Stability has no text API, so prompt expansion is delegated to another provider.
# STABILITY_TEXT_PROVIDER picks the delegate (gemini | local | openai; default is
# local/Ollama, which needs no extra cloud API key -- requires the local provider to be set up).
STABILITY_API_KEY=
STABILITY_TEXT_PROVIDER=local
STABILITY_FINAL_STRENGTH=0.35
# finalize (image-to-image) doesn't accept an aspect_ratio field, so it stays square
# like the preview (unlike the other 3 providers, it won't reach 16:9 -- see the
# module docstring in backend/providers/stability.py).
