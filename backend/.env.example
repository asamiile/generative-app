# AI Studioで発行したGemini APIキー
GEMINI_API_KEY=
# 4K finalize時のアスペクト比(gemini-3-pro-imageのimage_config.aspect_ratioが対応
# する値)。previewは元画像に合わせてスクエアのまま(この設定は適用されない)
GEMINI_ASPECT_RATIO=16:9

# フロントエンドとの認証に使う共有トークン(長いランダム文字列を設定する)
APP_API_TOKEN=

# 画像生成系エンドポイントのレート制限(1時間あたりのリクエスト数)
RATE_LIMIT_PER_HOUR=10

# SQLite接続文字列(docker-compose利用時は docker-compose.yml 側で上書きされる)
DATABASE_URL=sqlite:///./history.db

# ローカルプロバイダー使用時の接続先(docker-compose利用時はデフォルトのままでOK。
# サービス名で名前解決するため localhost ではなく ollama/comfyui を指す)
OLLAMA_BASE_URL=http://ollama:11434
# 事前に `docker compose exec ollama ollama pull <model>` でpullしておくこと。
# タグはモデルラインナップの変化が早いので https://ollama.com/library で要確認
OLLAMA_TEXT_MODEL=llama3.1:8b

COMFYUI_BASE_URL=http://comfyui:8188
# 実写系SDXLチェックポイント。comfyui_models ボリュームの models/checkpoints/ に
# 手動でダウンロードして配置すること(数GBあるためイメージには含めていない)。
# CPU実行(GPUパススルーなし)は非常に遅いため、通常の20〜30stepモデルではなく
# SDXL-Turbo/Lightning系の数stepモデルを強く推奨(下のCOMFYUI_STEPS等もそれ用の値)
COMFYUI_CHECKPOINT=juggernautXL_v10.safetensors
# ローカル生成のポーリングタイムアウト(秒)。CPU実行だと大幅に伸びるため要調整
LOCAL_GENERATION_TIMEOUT_SECONDS=900

# サンプリングパラメータ。既定値はSDXL-Turbo/Lightning系(数stepモデル)向け。
# 通常のcheckpoint(Juggernaut XLなど)を使う場合はsteps=20〜30, cfg=5〜7,
# sampler=dpmpp_2m, scheduler=karras 程度に戻すこと(ただしCPUだと非常に遅い)
COMFYUI_STEPS=8
COMFYUI_CFG=1.5
COMFYUI_SAMPLER=euler
COMFYUI_SCHEDULER=sgm_uniform
# スクエア(元画像がスクエアなので、previewの表示もスクエア)。finalizeは別途16:9を
# 狙うが、このpreview画像をリサイズする際はcrop="center"で中央クロップするため
# 引き伸ばしにはならない(img2img_upscale.jsonのImageScaleノード)
COMFYUI_WIDTH=1024
COMFYUI_HEIGHT=1024
# finalize(アップスケール)時のimg2img denoise strength。低いほど元画像の構図を維持
COMFYUI_UPSCALE_DENOISE=0.35
# finalizeの最終解像度(16:9)。AIアップスケールモデルは使わず、選択したpreview画像を
# このサイズにリサイズしてからimg2imgで精細化する。
# 実測(2026-08-08、CPU実行/Docker24GB、正方形換算): 同等ピクセル数(1024x1024相当)で
# 約7分、4倍(2048x2048相当)で1時間14分、3840x3840(真の4K)は7〜8時間規模になり
# 非現実的。1280x720は旧デフォルト(1024x1024)とほぼ同じピクセル数
COMFYUI_FINAL_WIDTH=1280
COMFYUI_FINAL_HEIGHT=720
# VAEEncode/VAEDecodeをタイル分割処理するためのタイルサイズ・オーバーラップ。
# 一括処理だと2048x2048でもCPU実行でOOMしたため、タイル処理(VAEEncodeTiled/
# VAEDecodeTiled)でピークメモリを抑えている。ComfyUI標準ノードの既定値と同じ
COMFYUI_VAE_TILE_SIZE=512
COMFYUI_VAE_TILE_OVERLAP=64

# OpenAI(GPT Image)プロバイダー。https://platform.openai.com/api-keys で発行
# モデル名は変化が早いので https://platform.openai.com/docs/models で要確認
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# previewはスクエア(公式標準サイズの1つ)。finalizeのみ16:9を狙う(標準サイズには
# 16:9ちょうどがないため、16の倍数かつ16:9ぴったりのカスタムサイズを指定。もし
# 拒否される場合は公式標準サイズ 1536x1024(3:2)に戻すこと)
OPENAI_PREVIEW_SIZE=1024x1024
OPENAI_FINAL_SIZE=2048x1152

# Stability AI(Stable Image)プロバイダー。https://platform.stability.ai/account/keys で発行
# StabilityはテキストAPIを持たないため、プロンプト拡張は他プロバイダーに委譲する。
# STABILITY_TEXT_PROVIDERで委譲先を選べる(gemini | local | openai、既定はlocal/Ollama
# — 追加のクラウドAPIキーなしで使える。local providerのセットアップが前提)
STABILITY_API_KEY=
STABILITY_TEXT_PROVIDER=local
STABILITY_FINAL_STRENGTH=0.35
# finalize(image-to-image)はaspect_ratio指定を受け付けないため、previewと同じく
# スクエアのまま(他3プロバイダーと異なり16:9にならない。backend/providers/stability.py
# のモジュールdocstring参照)
